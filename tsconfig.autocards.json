    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "outDir": ".ac-out",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "types": []
